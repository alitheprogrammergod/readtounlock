{
  "expo": {
    "name": "readtounlock",
    "slug": "readtounlock",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.readtounlock",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to scan book pages for reading verification.",
        "NSUserNotificationUsageDescription": "We'll notify you when your apps unlock and send reading reminders.",
        "NSFamilyControlsUsageDescription": "This app needs access to Family Controls to manage app restrictions based on your reading goals.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.family-controls": true,
        "com.apple.security.application-groups": [
          "group.com.anonymous.readtounlock"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "NOTIFICATIONS",
        "VIBRATE",
        "PACKAGE_USAGE_STATS",
        "BIND_ACCESSIBILITY_SERVICE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.readtounlock"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to scan book pages."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/adaptive-icon.png",
          "color": "#ffffff"
        }
      ],
      "./plugins/withDailyMonitor"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "0b0a1bfb-dec8-4096-80b4-561692b83151",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "RTUDailyMonitor",
                  "bundleIdentifier": "com.anonymous.readtounlock.daily-monitor",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.anonymous.readtounlock"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
